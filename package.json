{
  "name": "dsh-liquid-glass-theme",
  "version": "1.4.2",
  "description": "DSH液态玻璃皮肤插件：可调玻璃模糊、磨砂、壁纸与动态背景",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "SuperSgdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuperSgdk/DSH-Liquid-Glass-Theme.git"
  },
  "homepage": "https://github.com/SuperSgdk/DSH-Liquid-Glass-Theme#readme",
  "bugs": {
    "url": "https://github.com/SuperSgdk/DSH-Liquid-Glass-Theme/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "bundle": "pnpm run build",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm test",
    "sync": "node scripts/sync.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.1 || 0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.5-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "0.28.2",
    "lightningcss": "1.33.0",
    "playwright": "1.62.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "typescript": "5.9.3"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "tests",
    "tsconfig*.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "pack.ps1",
    "install.ps1",
    "cordis.patch.yml",
    "licenses",
    "docs",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
